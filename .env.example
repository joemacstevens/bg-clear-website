PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# WooCommerce (payment step only — see src/lib/server/woocommerce.ts).
# Store = the Pressable WordPress site running Bank of America's CyberSource plugin.
WOOCOMMERCE_STORE_URL=https://your-woo-site.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_your-consumer-key
WOOCOMMERCE_CONSUMER_SECRET=cs_your-consumer-secret
# Must equal the Secret on the Woo webhook that points at
# https://www.bgclear.com/api/webhooks/woocommerce
WOOCOMMERCE_WEBHOOK_SECRET=your-webhook-secret
