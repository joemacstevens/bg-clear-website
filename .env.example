PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public base URL for the site (used for OG tags, sitemap, magic-link
# redirects, transactional email links). Falls back to www.bgclear.com
# in code if unset — but you should set this per environment.
PUBLIC_SITE_URL=https://www.bgclear.com

# ============================================================
# WooCommerce fulfillment export
# ============================================================
# Approved orders are POSTed to ${WOO_API_URL}/wp-json/wc/v3/orders.
# Generate the consumer key/secret in WooCommerce → Settings → Advanced
# → REST API. Permissions: Read/Write.
WOO_API_URL=https://your-woocommerce-site.example.com
WOO_CONSUMER_KEY=ck_your_consumer_key_here
WOO_CONSUMER_SECRET=cs_your_consumer_secret_here

# ============================================================
# Bank of America via Cybersource Secure Acceptance Hosted Checkout
# ============================================================
# Profile-level credentials from the Cybersource Business Center
# (Payment Configuration → Secure Acceptance Settings). The profile
# must have:
#   transaction_response_url -> https://your-domain/api/webhooks/cybersource/return
#   merchant_post_url        -> https://your-domain/api/webhooks/cybersource
# Set CYBERSOURCE_ENV=test for testsecureacceptance.cybersource.com,
# or =prod for secureacceptance.cybersource.com.
CYBERSOURCE_MERCHANT_ID=your-merchant-id
CYBERSOURCE_ACCESS_KEY=your-access-key
CYBERSOURCE_SECRET_KEY=your-secret-key
CYBERSOURCE_PROFILE_ID=your-profile-id
CYBERSOURCE_ENV=test
